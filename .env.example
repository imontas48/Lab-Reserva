APP_NAME="Lab-Reserva"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de Datos - Configurar según tu entorno
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lab_reserva
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Sanctum Configuration
# Dejar SIN definir en local: config/sanctum.php ya incluye un fallback con
# localhost, 127.0.0.1 y la URL de la app. Definirla vacia NO usa ese fallback
# (env() devuelve '', no null) y rompe la autenticacion por cookie.
# Definirla solo en despliegue, con los dominios reales separados por coma.
# SANCTUM_STATEFUL_DOMAINS=

# Frontend Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_API_URL=

# Cuotas de reserva por rol (ausente = valor por defecto de config/lab-reserva.php).
# LAB_RESERVA_STUDENT_MAX_ACTIVE=3
# LAB_RESERVA_STUDENT_MAX_ADVANCE_DAYS=14
# LAB_RESERVA_STUDENT_MAX_HOURS=4
# LAB_RESERVA_TEACHER_MAX_ACTIVE=10
# LAB_RESERVA_TEACHER_MAX_ADVANCE_DAYS=60
# LAB_RESERVA_TEACHER_MAX_HOURS=8
# LAB_RESERVA_REMINDER_HOURS_BEFORE=24
# LAB_RESERVA_RECURRENCE_MAX_WEEKS=16
# LAB_RESERVA_CHECKIN_OPENS_BEFORE=10
# LAB_RESERVA_CHECKIN_GRACE=15
# LAB_RESERVA_NO_SHOW_MAX_STRIKES=3
# LAB_RESERVA_NO_SHOW_WINDOW_DAYS=30
# LAB_RESERVA_NO_SHOW_BLOCK_DAYS=7
